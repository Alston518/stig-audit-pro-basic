					<VULN_ATTRIBUTE>STIGRef</VULN_ATTRIBUTE>
					<ATTRIBUTE_DATA>Cisco IOS Switch NDM Security Technical Implementation Guide :: Version 3, Release: 8 Benchmark Date: 01 Jul 2026</ATTRIBUTE_DATA>
				</STIG_DATA>
