					<ATTRIBUTE_DATA>SV-110443</ATTRIBUTE_DATA>
				</STIG_DATA>
				<STIG_DATA>
					<VULN_ATTRIBUTE>CCI_REF</VULN_ATTRIBUTE>
					<ATTRIBUTE_DATA>CCI-002890</ATTRIBUTE_DATA>
				</STIG_DATA>
				<STIG_DATA>
