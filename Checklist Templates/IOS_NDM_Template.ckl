					<VULN_ATTRIBUTE>Rule_ID</VULN_ATTRIBUTE>
					<ATTRIBUTE_DATA>SV-220601r1015287_rule</ATTRIBUTE_DATA>
				</STIG_DATA>
				<STIG_DATA>
