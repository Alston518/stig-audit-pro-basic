					<VULN_ATTRIBUTE>STIG_UUID</VULN_ATTRIBUTE>
					<ATTRIBUTE_DATA>e755ab95-4aad-42e7-8951-9af19f8b0c4b</ATTRIBUTE_DATA>
				</STIG_DATA>
				<STIG_DATA>
					<VULN_ATTRIBUTE>LEGACY_ID</VULN_ATTRIBUTE>
					<ATTRIBUTE_DATA>V-101291</ATTRIBUTE_DATA>
				</STIG_DATA>
				<STIG_DATA>
