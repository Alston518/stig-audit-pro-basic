					<ATTRIBUTE_DATA>Cisco IOS Switch L2S Security Technical Implementation Guide :: Version 3, Release: 2 Benchmark Date: 01 Jul 2026</ATTRIBUTE_DATA>
				</STIG_DATA>
				<STIG_DATA>
					<VULN_ATTRIBUTE>TargetKey</VULN_ATTRIBUTE>
					<ATTRIBUTE_DATA>4070</ATTRIBUTE_DATA>
				</STIG_DATA>
